      "expected": {
        "status": "resolved",
        "instant": "2026-02-15T12:00:00-05:00"
      }
    },
    {
      "id": "invalid-spring-forward-time",
      "input": {
        "localDateTime": "2026-03-08T02:30:00",
        "timeZoneId": "America/New_York"
      },
      "expected": { "status": "invalid", "instant": null }
    },
    {
      "id": "ambiguous-fall-back-time",
      "input": {
        "localDateTime": "2026-11-01T01:30:00",
        "timeZoneId": "America/New_York"
      },
      "expected": { "status": "ambiguous", "instant": null }
    }
  ]
}
