{
  "schemaVersion": 1,
  "operation": "applicationLifecycle",
  "cases": [
    {
      "id": "planning-retry-is-idempotent",
      "input": {
        "action": "planTwice",
        "failFirstMarkPlanned": true,
        "futureTodo": {
          "id": "00000000-0000-0000-0000-000000000401",
          "title": "需要规划",
          "scheduledDate": "2026-07-29",
          "isMandatory": false
        },
        "start": "2026-07-29T18:00:00+08:00",
        "durationSeconds": 1800
      },
      "expected": {
        "futureStatus": "planned",
        "scheduledTodoId": "00000000-0000-0000-0000-000000000401",
        "replaceCount": 1
      }
    },
    {
      "id": "unconfirmed-delete-keeps-active",
      "input": {
        "action": "deleteFuture",
