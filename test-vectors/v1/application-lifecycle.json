        "futureTodo": {
          "id": "00000000-0000-0000-0000-000000000411",
          "title": "保留事项",
          "scheduledDate": "2026-07-30",
          "isMandatory": false
        }
      },
      "expected": { "futureStatus": "active" }
    },
    {
      "id": "confirmed-delete-is-distinct",
      "input": {
        "action": "deleteFuture",
        "isConfirmed": true,
        "futureTodo": {
          "id": "00000000-0000-0000-0000-000000000412",
          "title": "删除事项",
          "scheduledDate": "2026-07-30",
          "isMandatory": false
        }
      },
      "expected": { "futureStatus": "deleted" }
    },
    {
      "id": "natural-completion-preserves-history",
      "input": {
        "action": "loadManagement",
        "now": "2026-07-29T12:00:00+08:00",
        "scheduledTodos": [
          {
            "id": "00000000-0000-0000-0000-000000000421",
            "title": "已自然完成",
            "start": "2026-07-29T10:00:00+08:00",
            "end": "2026-07-29T11:00:00+08:00",
            "isMandatory": false,
            "currentSelectionPriority": 0
          },
          {
            "id": "00000000-0000-0000-0000-000000000422",
            "title": "仍然活动",
            "start": "2026-07-29T12:00:00+08:00",
            "end": "2026-07-29T13:00:00+08:00",
            "isMandatory": false,
            "currentSelectionPriority": 1
          }
        ]
      },
      "expected": {
        "activeTodoIds": ["00000000-0000-0000-0000-000000000422"],
        "history": [
          {
            "id": "00000000-0000-0000-0000-000000000421",
            "status": "completed",
            "completedAt": "2026-07-29T12:00:00+08:00"
          },
          {
            "id": "00000000-0000-0000-0000-000000000422",
            "status": "active",
            "completedAt": null
          }
        ]
      }
    },
    {
      "id": "opening-includes-overdue-and-due-future-todos",
