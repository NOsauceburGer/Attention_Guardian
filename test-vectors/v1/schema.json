{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attentionguardian.local/test-vectors/v1/schema.json",
  "title": "Attention Guardian shared test-vector envelope v1",
  "type": "object",
  "required": ["schemaVersion", "operation", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": {
      "enum": ["selectCurrent", "insertSchedule", "manageSchedule", "evaluateReminder", "resolveLocalDateTime", "applicationLifecycle"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "selectCurrent" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/selectCurrentCase" } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "insertSchedule" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/insertScheduleCase" } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "manageSchedule" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/manageScheduleCase" } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "evaluateReminder" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/evaluateReminderCase" } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "resolveLocalDateTime" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/resolveLocalDateTimeCase" } } } }
    },
    {
      "if": { "properties": { "operation": { "const": "applicationLifecycle" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/applicationLifecycleCase" } } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "localDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "scheduledTodo": {
      "type": "object",
      "required": ["id", "title", "start", "end", "isMandatory", "currentSelectionPriority"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/instant" },
        "end": { "$ref": "#/$defs/instant" },
        "isMandatory": { "type": "boolean" },
        "currentSelectionPriority": { "type": "integer", "minimum": 0 }
      }
    },
    "scheduledTodoArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/scheduledTodo" }
    },
    "futureTodo": {
      "type": "object",
      "required": ["id", "title", "scheduledDate", "isMandatory"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "scheduledDate": { "type": "string", "format": "date" },
        "isMandatory": { "type": "boolean" }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "input": { "type": "object" },
        "expected": { "type": "object" }
      }
    },
    "selectCurrentCase": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        {
          "properties": {
            "input": {
              "required": ["now", "schedule"],
              "properties": {
                "now": { "$ref": "#/$defs/instant" },
                "schedule": { "$ref": "#/$defs/scheduledTodoArray" }
              }
            },
            "expected": {
              "required": ["currentTodoId"],
              "properties": {
                "currentTodoId": {
                  "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
                }
              }
            }
          }
        }
      ]
    },
    "insertScheduleCase": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        {
          "properties": {
            "input": {
              "required": ["schedule", "proposedTodo"],
              "properties": {
                "schedule": { "$ref": "#/$defs/scheduledTodoArray" },
                "proposedTodo": { "$ref": "#/$defs/scheduledTodo" }
              }
            },
            "expected": {
              "required": ["schedule", "hasRolloverToNextDay", "conflicts"],
              "properties": {
                "schedule": { "$ref": "#/$defs/scheduledTodoArray" },
                "hasRolloverToNextDay": { "type": "boolean" },
                "conflicts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["proposedTodoId", "mandatoryTodoId"],
                    "additionalProperties": false,
                    "properties": {
                      "proposedTodoId": { "$ref": "#/$defs/uuid" },
                      "mandatoryTodoId": { "$ref": "#/$defs/uuid" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "manageScheduleCase": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        {
          "properties": {
            "input": {
              "required": ["action", "todoId", "schedule"],
              "properties": {
                "action": { "enum": ["reorder", "delete", "insertBreak", "edit", "editStart"] },
                "todoId": { "$ref": "#/$defs/uuid" },
                "schedule": { "$ref": "#/$defs/scheduledTodoArray" },
                "requestedIndex": { "type": "integer", "minimum": 0 },
                "start": { "$ref": "#/$defs/instant" },
                "durationSeconds": { "type": "integer", "minimum": 1 },
                "currentSelectionPriority": { "type": "integer", "minimum": 0 },
                "title": { "type": "string", "minLength": 1 },
                "isMandatory": { "type": "boolean" },
                "newStart": { "$ref": "#/$defs/instant" },
                "conflictResolution": {
                  "oneOf": [
                    {
                      "enum": [
                        "moveExistingAfterEdited",
                        "truncateExistingAtNewStart"
                      ]
                    },
                    { "type": "null" }
                  ]
                }
              }
            },
            "expected": {
              "properties": {
                "schedule": { "$ref": "#/$defs/scheduledTodoArray" },
                "actualIndex": { "type": "integer", "minimum": 0 },
                "usedFallbackPosition": { "type": "boolean" },
                "status": { "enum": ["applied", "rejected"] },
                "reason": {
                  "enum": [
                    "breakCannotBeRenamed",
                    "mandatoryTodoOccupiesNewStart"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "evaluateReminderCase": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        {
          "properties": {
            "input": {
              "required": ["now", "schedule"],
              "properties": {
                "now": { "$ref": "#/$defs/instant" },
                "schedule": { "$ref": "#/$defs/scheduledTodoArray" }
              }
            },
            "expected": {
              "required": ["shouldNotifyNow", "ineligibility", "currentTodoId", "nextTodoId"],
              "properties": {
                "shouldNotifyNow": { "type": "boolean" },
                "ineligibility": {
                  "enum": [
                    "none",
                    "noCurrentTodo",
                    "currentTodoTooShort",
                    "noAdjacentNextTodo",
                    "nextTodoIsBreak",
                    "outsideReminderWindow"
                  ]
                },
                "currentTodoId": {
                  "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
                },
                "nextTodoId": {
                  "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
                }
              }
            }
          }
        }
      ]
    },
    "resolveLocalDateTimeCase": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        {
          "properties": {
            "input": {
              "required": ["localDateTime", "timeZoneId"],
              "properties": {
                "localDateTime": { "$ref": "#/$defs/localDateTime" },
                "timeZoneId": { "type": "string", "minLength": 1 }
              }
            },
            "expected": {
              "required": ["status", "instant"],
              "properties": {
                "status": { "enum": ["resolved", "invalid", "ambiguous"] },
                "instant": {
                  "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }]
                }
              }
            }
          }
        }
      ]
    },
    "applicationLifecycleCase": {
      "allOf": [
        { "$ref": "#/$defs/case" },
        {
          "properties": {
            "input": {
              "required": ["action"],
              "properties": {
                "action": {
                  "enum": [
                    "planTwice",
                    "deleteFuture",
                    "loadManagement",
                    "loadOpening",
                    "deleteScheduled",
                    "replaceSchedule",
                    "addRelativeFuture"
                  ]
                },
                "now": { "$ref": "#/$defs/instant" },
                "futureTodo": { "$ref": "#/$defs/futureTodo" },
                "futureTodos": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/futureTodo" }
                },
                "scheduledTodos": { "$ref": "#/$defs/scheduledTodoArray" },
                "replacementSchedule": { "$ref": "#/$defs/scheduledTodoArray" },
                "start": { "$ref": "#/$defs/instant" },
                "durationSeconds": { "type": "integer", "minimum": 1 },
                "failFirstMarkPlanned": { "type": "boolean" },
                "isConfirmed": { "type": "boolean" }
                ,"todoId": { "$ref": "#/$defs/uuid" }
                ,"daysFromToday": { "type": "integer", "minimum": 1 }
              }
            },
            "expected": {
              "properties": {
                "futureStatus": { "enum": ["active", "planned", "deleted"] },
                "scheduledTodoId": { "$ref": "#/$defs/uuid" },
                "replaceCount": { "type": "integer", "minimum": 0 },
                "activeTodoIds": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/uuid" }
                },
                "dueFutureTodoIds": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/uuid" }
                },
                "savedDate": { "type": "string", "format": "date" },
                "history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "status", "completedAt"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "$ref": "#/$defs/uuid" },
                      "status": { "enum": ["active", "completed", "deleted"] },
                      "completedAt": {
                        "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
