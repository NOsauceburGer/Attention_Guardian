<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AttentionGuardian.Desktop.ViewModels"
        xmlns:app="using:AttentionGuardian.Application"
        xmlns:core="using:AttentionGuardian.Core"
        xmlns:views="using:AttentionGuardian.Desktop.Views"
        xmlns:controls="using:AttentionGuardian.Desktop.Controls"
        x:Class="AttentionGuardian.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1040" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Title="托管时间"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        PointerPressed="WindowPointerPressed"
        PointerMoved="WindowPointerMoved"
        PointerReleased="WindowPointerReleased">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border x:Name="WindowShell" CornerRadius="14" ClipToBounds="True"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="#26FFFFFF" BorderThickness="1">
    <Grid x:Name="Root">
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1A2027" Offset="0" />
                    <GradientStop Color="#111418" Offset="0.56" />
                    <GradientStop Color="#0C0F12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <views:AmbientFocusSurface x:Name="AmbientSurface"
                                   IsActive="{Binding IsFocusStarted}"
                                   TaskKey="{Binding CurrentTodoKey}" />

        <Grid x:Name="PageContent" Margin="48">
            <Grid IsVisible="{Binding IsFocusPage}" RowDefinitions="Auto,*">
                <StackPanel Spacing="10">
                    <Border Classes="AlertGlass"
                            IsVisible="{Binding HasCrossDayNotice}"
                            AutomationProperties.Name="有事件被顺延至明日">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="#BFF0C86B" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="有事件被顺延至明日"
                                       FontSize="14" LineHeight="21" FontWeight="Medium"
                                       Foreground="#F0F5F7F9" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="×"
                                    Command="{Binding CloseCrossDayCommand}"
                                    Classes="Glass" MinWidth="34" MinHeight="34" Padding="0"
                                    AutomationProperties.Name="关闭跨日顺延提醒" />
                        </Grid>
                    </Border>
                    <Border Classes="AlertGlass"
                            IsVisible="{Binding HasDueTodos}"
                            DoubleTapped="DueReminderDoubleTapped"
                            AutomationProperties.Name="有当日未设置时间待办，双击展开">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="6" Height="6" CornerRadius="3"
                                        Background="#BFC97470" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="有当日未设置时间待办"
                                           FontSize="14" LineHeight="21" FontWeight="Medium"
                                           Foreground="#F0F5F7F9" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel IsVisible="{Binding IsDueExpanded}" Spacing="10">
                                <ItemsControl ItemsSource="{Binding DueTodos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:UnscheduledTodo">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="16,2,0,2">
                                                <TextBlock Text="{Binding Title}" Classes="Secondary"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="规划"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlanDueTodoCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="Glass" MinHeight="36" Padding="14,6" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid IsVisible="{Binding HasConflicts}"
                          HorizontalAlignment="Center"
                          Width="430"
                          DoubleTapped="ConflictReminderDoubleTapped"
                          AutomationProperties.Name="有不可移动事件冲突，双击展开">
                        <Border Classes="AlertGlass">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Width="6" Height="6"
                                            CornerRadius="3"
                                            Background="#BFD56A66"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="有不可移动事件冲突"
                                               FontSize="14"
                                               LineHeight="21"
                                               FontWeight="Medium"
                                               Foreground="#F0F5F7F9"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel IsVisible="{Binding IsConflictExpanded}"
                                            Spacing="9"
                                            Margin="16,2,0,2">
                                    <ItemsControl ItemsSource="{Binding Conflicts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ScheduleConflict">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                    <TextBlock Text="{Binding ProposedTodo.Title}"
                                                               FontSize="14" Foreground="#D6E5E9EC" />
                                                    <TextBlock Text="与"
                                                               FontSize="14" Foreground="#D6E5E9EC" />
                                                    <TextBlock Text="{Binding MandatoryTodo.Title}"
                                                               FontSize="14" Foreground="#D6E5E9EC" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="进入管理"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenManageCommand}"
                                            Classes="Glass"
                                            MinHeight="36"
                                            Padding="14,6"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22"
                                MaxWidth="720">
                        <Canvas IsVisible="{Binding CanStartFocus}" Width="390" Height="390"
                                HorizontalAlignment="Center">
                            <Ellipse Canvas.Left="107" Canvas.Top="13" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="177" Canvas.Top="43" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="201" Canvas.Top="107" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="177" Canvas.Top="171" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="107" Canvas.Top="201" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="37" Canvas.Top="171" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="13" Canvas.Top="107" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="37" Canvas.Top="43" Width="176" Height="176"
                                     Classes="AmbientOrbit" />
                            <Ellipse Canvas.Left="105" Canvas.Top="99" Width="180" Height="180"
                                     Fill="#255AA7F5"
                                     IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="18" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Canvas.Left="113" Canvas.Top="107" Width="164" Height="164"
                                     Stroke="#EEF2FAFF" StrokeThickness="1.7"
                                     IsHitTestVisible="False" />
                            <Button Canvas.Left="113" Canvas.Top="107"
                                    Content="开始" Command="{Binding StartFocusCommand}"
                                    Classes="FocusEntry"
                                    AutomationProperties.Name="开始专注" />
                        </Canvas>
                        <StackPanel x:Name="FocusedContent"
                                    IsVisible="{Binding ShowFocusedTodo}" Spacing="18"
                                    HorizontalAlignment="Center">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.46" />
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.46" />
                                </Transitions>
                            </StackPanel.Transitions>
                            <TextBlock Text="{Binding CurrentTodoTitle}" FontSize="44" FontWeight="SemiBold"
                                       MaxWidth="720" LineHeight="60" Padding="0,2,0,7"
                                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFF8FBFF" />
                            <TextBlock Text="未来的事项已为你托管" Classes="Body" LetterSpacing="0.4"
                                       TextAlignment="Center" Foreground="#D9E7F4FA" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding ShowEmptyFocus}" Text="现在没有需要执行的事件"
                                   FontSize="18" LineHeight="27" Foreground="#E6F0F7FB"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel IsVisible="{Binding IsAddTypePage}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Width="590">
                <TextBlock Text="添加事件" Classes="PageTitle" Margin="0,0,0,12" />
                <Button Command="{Binding ChooseScheduledCommand}" Background="Transparent" Padding="0"
                        HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Width="590"
                        AutomationProperties.Name="当日待办，今天要做什么">
                    <Grid>
                        <Border Classes="ChoiceRow" Padding="22,18">
                            <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="18">
                                <Border Width="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="当日待办" Classes="SectionTitle" />
                                    <TextBlock Text="今天要做什么？" Classes="Secondary" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="28"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
                <Button Command="{Binding ChooseFutureCommand}" Background="Transparent" Padding="0"
                        HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Width="590"
                        AutomationProperties.Name="未来待办，这些事情之后做">
                    <Grid>
                        <Border Classes="ChoiceRow" Padding="22,18">
                            <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="18">
                                <Border Width="6" CornerRadius="3" Background="#668C9AA8" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="未来待办" Classes="SectionTitle" />
                                    <TextBlock Text="这些事情之后做" Classes="Secondary" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="28"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
                <Button Content="返回" Command="{Binding BackCommand}" Classes="Glass"
                        HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>

            <Grid IsVisible="{Binding IsAddScheduledPage}" Width="650"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Classes="Surface" Padding="34">
                    <StackPanel Spacing="18">
                    <TextBlock Text="当日待办" Classes="FormTitle"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="名称" Classes="FieldLabel" /><TextBox Text="{Binding ScheduledTitle}" />
                    <Grid ColumnDefinitions="220,244"
                          ColumnSpacing="30"
                          HorizontalAlignment="Center">
                        <StackPanel Spacing="7">
                            <TextBlock Text="开始时间" Classes="FieldLabel" />
                            <Grid ColumnDefinitions="96,12,96"
                                  RowDefinitions="20,44"
                                  RowSpacing="5"
                                  Width="204"
                                  HorizontalAlignment="Left">
                                <TextBlock Text="小时" Classes="Caption" />
                                <TextBlock Grid.Column="2" Text="分钟" Classes="Caption" />
                                <controls:GlassPicker Grid.Row="1"
                                                      ItemsSource="{Binding StartHourOptions}"
                                                      SelectedItem="{Binding ScheduledHour}"
                                                      PopupWidth="156" Label="开始时间小时" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text=":"
                                           FontSize="18"
                                           Width="12"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center" />
                                <controls:GlassPicker Grid.Row="1" Grid.Column="2"
                                                      ItemsSource="{Binding StartMinuteOptions}"
                                                      SelectedItem="{Binding ScheduledMinute}"
                                                      PopupWidth="156" Label="开始时间分钟" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="持续时间" Classes="FieldLabel" />
                            <Grid ColumnDefinitions="116,116"
                                  RowDefinitions="20,44"
                                  ColumnSpacing="12"
                                  RowSpacing="5">
                                <TextBlock Text="小时" Classes="Caption" />
                                <TextBlock Grid.Column="1" Text="分钟" Classes="Caption" />
                                <controls:GlassNumberStepper Grid.Row="1"
                                                            Value="{Binding DurationHours}"
                                                            Minimum="0"
                                                            Maximum="48"
                                                            Label="持续小时" />
                                <controls:GlassNumberStepper Grid.Row="1"
                                                            Grid.Column="1"
                                                            Value="{Binding DurationMinutes}"
                                                            Minimum="0"
                                                            Maximum="59"
                                                            Label="持续分钟" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="不可移动事件" IsChecked="{Binding IsMandatory}" />
                    <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="保存" Command="{Binding SaveScheduledCommand}" Classes="Primary" />
                        <Button Content="返回" Command="{Binding BackCommand}" Classes="Glass" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsAddFuturePage}" Width="600"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Classes="Surface" Padding="34">
                    <StackPanel Spacing="18">
                    <TextBlock Text="未来待办" Classes="FormTitle"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="名称" Classes="FieldLabel" /><TextBox Text="{Binding FutureTitle}" />
                    <TextBlock Text="快捷日期" Classes="FieldLabel" />
                    <Grid ColumnDefinitions="116,116"
                          ColumnSpacing="12"
                          HorizontalAlignment="Center">
                        <Button Content="一天后" Command="{Binding SelectFutureOneDayCommand}"
                                Classes="Glass RelativeDateOption"
                                Classes.Selected="{Binding IsFutureOneDaySelected}"
                                AutomationProperties.Name="选择一天后" />
                        <Button Grid.Column="1" Content="两天后"
                                Command="{Binding SelectFutureTwoDaysCommand}"
                                Classes="Glass RelativeDateOption"
                                Classes.Selected="{Binding IsFutureTwoDaysSelected}"
                                AutomationProperties.Name="选择两天后" />
                    </Grid>
                    <TextBlock Text="或选择具体日期" Classes="FieldLabel" />
                    <Grid ColumnDefinitions="132,104,104"
                          ColumnSpacing="10"
                          HorizontalAlignment="Center">
                        <StackPanel Spacing="6">
                            <TextBlock Text="年" Classes="Caption" />
                            <controls:GlassPicker ItemsSource="{Binding FutureYearOptions}"
                                                  SelectedItem="{Binding FutureYear}"
                                                  PopupWidth="174" Label="未来待办年份" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="月" Classes="Caption" />
                            <controls:GlassPicker ItemsSource="{Binding FutureMonthOptions}"
                                                  SelectedItem="{Binding FutureMonth}"
                                                  PopupWidth="156" Label="未来待办月份" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="日" Classes="Caption" />
                            <controls:GlassPicker ItemsSource="{Binding FutureDayOptions}"
                                                  SelectedItem="{Binding FutureDay}"
                                                  PopupWidth="156" Label="未来待办日期" />
                        </StackPanel>
                    </Grid>
                    <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="保存" Command="{Binding SaveFutureCommand}" Classes="Primary" />
                        <Button Content="返回" Command="{Binding BackCommand}" Classes="Glass" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsManagePage}" RowDefinitions="Auto,*" ColumnDefinitions="*,220" ColumnSpacing="26">
                <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                    <TextBlock Text="事件管理" Classes="PageTitle" />
                    <Button Grid.Column="1" Content="返回" Command="{Binding BackCommand}" Classes="Glass"
                            Margin="0,22,0,0" />
                </Grid>
                <ScrollViewer x:Name="ManagementScrollViewer" Grid.Row="1" Margin="0,26,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ScheduledRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScheduledTodoRowViewModel">
                                    <ItemsControl ItemsSource="{Binding Items}"
                                                  Classes.MandatoryGroupRow="{Binding IsMandatoryGroup}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScheduledTodoBubbleViewModel">
                                                <Border Classes="Glass ScheduledBubble" Padding="20,16" Margin="0,0,10,10"
                                            Focusable="True"
                                            AutomationProperties.HelpText="按 Alt+上箭头或 Alt+下箭头调整顺序"
                                            Classes.Mandatory="{Binding Model.IsMandatory}"
                                            Classes.Rest="{Binding IsBreak}"
                                            DragDrop.AllowDrop="True"
                                            DoubleTapped="ScheduledBubbleDoubleTapped"
                                            DragDrop.DragOver="ScheduledBubbleDragOver"
                                            DragDrop.DragLeave="ScheduledBubbleDragLeave"
                                            DragDrop.Drop="ScheduledBubbleDrop"
                                            KeyDown="ScheduledBubbleKeyDown">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="Glass DragHandle" Width="36" Height="36"
                                                        Cursor="SizeAll"
                                                        PointerPressed="ScheduledDragHandlePressed"
                                                        PointerMoved="DragHandlePointerMoved"
                                                        PointerReleased="DragHandlePointerReleased"
                                                        PointerCaptureLost="DragHandlePointerCaptureLost"
                                                        AutomationProperties.Name="拖动事件调整顺序">
                                                    <TextBlock Text="⋮⋮" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Model.Title}" FontSize="17"
                                                           FontWeight="SemiBold" LineHeight="23"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" IsVisible="{Binding Model.IsMandatory}"
                                                           Text="不可移动" Classes="StatusLabel"
                                                           Foreground="{DynamicResource ErrorBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Classes="BubbleEditor"
                                                    IsVisible="{Binding IsExpanded}">
                                                <StackPanel Spacing="12" Margin="0,14,0,0">
                                                    <TextBlock Text="名称" Classes="FieldLabel" />
                                                    <TextBox Text="{Binding Title}" IsReadOnly="{Binding IsBreak}" />
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                        <StackPanel Spacing="7">
                                                            <TextBlock Text="小时" Classes="FieldLabel" />
                                                            <controls:GlassNumberStepper Value="{Binding DurationHours}"
                                                                                        Minimum="0"
                                                                                        Maximum="48"
                                                                                        Label="事件持续小时" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="7">
                                                            <TextBlock Text="分钟" Classes="FieldLabel" />
                                                            <controls:GlassNumberStepper Value="{Binding DurationMinutes}"
                                                                                        Minimum="0"
                                                                                        Maximum="59"
                                                                                        Label="事件持续分钟" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <CheckBox Content="不可移动事件" IsChecked="{Binding IsMandatory}"
                                                              IsEnabled="{Binding !IsBreak}" />
                                                    <Button Content="删除" Command="{Binding DeleteCommand}"
                                                            HorizontalAlignment="Left" Foreground="{DynamicResource ErrorBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="Glass RestDropZone" Padding="16,12"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="QueueEndDropZoneDragOver"
                                DragDrop.DragLeave="ScheduledBubbleDragLeave"
                                DragDrop.Drop="QueueEndDropZoneDrop">
                            <TextBlock Text="将事件拖到这里移至队尾，也可在此放入休息" Classes="Secondary"
                                       TextAlignment="Center" />
                        </Border>
                        <Button Content="展开未来待办" Command="{Binding ToggleFutureCommand}" Classes="Glass" HorizontalAlignment="Left" />
                        <ItemsControl IsVisible="{Binding IsFutureExpanded}" ItemsSource="{Binding FutureTodos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FutureTodoBubbleViewModel">
                                    <Border Classes="Glass" Padding="20,16" Margin="0,0,0,10"
                                            DoubleTapped="FutureBubbleDoubleTapped">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Model.Title}" Classes="Body"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Model.ScheduledDate}"
                                                           Classes="Secondary" />
                                            </Grid>
                                            <Border Classes="BubbleEditor"
                                                    IsVisible="{Binding IsExpanded}">
                                                <StackPanel Spacing="12" Margin="0,14,0,0">
                                                    <TextBlock Text="名称" Classes="FieldLabel" />
                                                    <TextBox Text="{Binding Title}" />
                                                    <TextBlock Text="日期" Classes="FieldLabel" />
                                                    <Grid ColumnDefinitions="132,104,104"
                                                          ColumnSpacing="10"
                                                          HorizontalAlignment="Left">
                                                        <controls:GlassPicker ItemsSource="{Binding YearOptions}"
                                                                              SelectedItem="{Binding ScheduledYear}"
                                                                              PopupWidth="154" Label="未来待办年份" />
                                                        <controls:GlassPicker Grid.Column="1"
                                                                              ItemsSource="{Binding MonthOptions}"
                                                                              SelectedItem="{Binding ScheduledMonth}"
                                                                              PopupWidth="142" Label="未来待办月份" />
                                                        <controls:GlassPicker Grid.Column="2"
                                                                              ItemsSource="{Binding DayOptions}"
                                                                              SelectedItem="{Binding ScheduledDay}"
                                                                              PopupWidth="142" Label="未来待办日期" />
                                                    </Grid>
                                                    <Button Content="删除" Command="{Binding DeleteCommand}"
                                                            HorizontalAlignment="Left" Foreground="{DynamicResource ErrorBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Grid.Column="1" Classes="Glass" Margin="0,26,0,0" Padding="18" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="休息" Classes="SectionTitle" />
                        <TextBlock Text="可重复拖入主列表" Classes="Secondary" />
                        <StackPanel Spacing="7">
                            <TextBlock Text="小时" Classes="FieldLabel" />
                            <controls:GlassPicker ItemsSource="{Binding RestHourOptions}"
                                                  SelectedItem="{Binding RestDurationHours}"
                                                  PopupWidth="156" Label="休息持续小时" />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Text="分钟" Classes="FieldLabel" />
                            <controls:GlassPicker ItemsSource="{Binding RestMinuteOptions}"
                                                  SelectedItem="{Binding RestDurationMinutes}"
                                                  PopupWidth="156" Label="休息持续分钟" />
                        </StackPanel>
                        <Border Classes="Glass RestTemplateDragHandle" Padding="16,11"
                                Background="{DynamicResource RestBrush}" Cursor="SizeAll"
                                PointerPressed="RestTemplatePointerPressed"
                                PointerMoved="DragHandlePointerMoved"
                                PointerReleased="DragHandlePointerReleased"
                                PointerCaptureLost="DragHandlePointerCaptureLost"
                                AutomationProperties.Name="拖动休息模板">
                            <TextBlock Text="拖动休息" TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <Button Content="加入队尾" Command="{Binding AddRestCommand}"
                                Classes="Glass"
                                AutomationProperties.Name="将休息加入队尾" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsAcceptancePage}" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto"
                      ColumnSpacing="10" Margin="0,0,0,18">
                    <Button Content="返回" Command="{Binding BackCommand}" Classes="Glass" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="本地验收检查" Classes="PageTitle"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="使用内存样例，不读取或修改你的真实待办"
                                   Classes="Secondary" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="测试 Windows 提醒"
                            Click="SendTestHandoffNotification" Classes="Glass" />
                    <Button Grid.Column="3" Content="运行全部检查"
                            Command="{Binding RunAcceptanceCommand}" Classes="Primary" />
                    <TextBlock x:Name="NotificationTestStatus"
                               Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                               Classes="Caption" HorizontalAlignment="Right"
                               Margin="0,7,0,0" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding AcceptanceResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="app:AcceptanceScenarioResult">
                                <Border Classes="Glass" Margin="0,0,0,10" Padding="16,13">
                                    <Grid ColumnDefinitions="18,200,*,120" ColumnSpacing="12">
                                        <Border Width="8" Height="8" CornerRadius="4"
                                                Background="#BFE5F5FF" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Expected}"
                                                   Classes="Secondary" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding Actual}"
                                                   Classes="Secondary" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border x:Name="Drawer" Classes="Glass" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,50,0,0" Padding="4" CornerRadius="11"
                Width="{Binding DrawerWidth}"
                Opacity="0" IsHitTestVisible="False"
                RenderTransform="translateY(-24px)">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" />
                </Transitions>
            </Border.Transitions>
            <Grid>
                <Grid ColumnDefinitions="*,1,*"
                      IsVisible="{Binding !IsAcceptanceAvailable}">
                    <Button Content="添加事件" Command="{Binding OpenAddCommand}" Classes="Nav"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="添加事件" />
                    <Border Grid.Column="1" Width="1" Height="18" Background="#42FFFFFF"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="事件管理" Command="{Binding OpenManageCommand}" Classes="Nav"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="事件管理" />
                </Grid>
                <Grid ColumnDefinitions="*,1,*,1,*"
                      IsVisible="{Binding IsAcceptanceAvailable}">
                    <Button Content="添加事件" Command="{Binding OpenAddCommand}" Classes="Nav"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="添加事件" />
                    <Border Grid.Column="1" Width="1" Height="18" Background="#42FFFFFF"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="事件管理" Command="{Binding OpenManageCommand}" Classes="Nav"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="事件管理" />
                    <Border Grid.Column="3" Width="1" Height="18" Background="#42FFFFFF"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="验收检查" Command="{Binding OpenAcceptanceCommand}" Classes="Nav"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="打开本地验收检查" />
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="DrawerHandle" Width="42" Height="4" CornerRadius="2" Background="#70FFFFFF"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0"
                AutomationProperties.Name="下拉导航把手" />
        <Border IsVisible="{Binding IsShiftToastVisible}" Classes="AlertGlass"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,64,0,0"
                Width="430">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="6" Height="6" CornerRadius="3"
                        Background="#BFE5F5FF" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="有事件被顺延"
                           FontSize="14" LineHeight="21" FontWeight="Medium"
                           Foreground="#F0F5F7F9" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel x:Name="WindowControlsPanel"
                    Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,16,0"
                    Opacity="0"
                    IsHitTestVisible="False">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.52" />
                </Transitions>
            </StackPanel.Transitions>
            <Button Classes="WindowControl" Click="MinimizeWindow"
                    AutomationProperties.Name="最小化窗口">
                <PathIcon Width="14" Height="14"
                          Data="M 2,6 L 12,6 L 12,7.5 L 2,7.5 Z" />
            </Button>
            <Button Classes="WindowControl" Click="ToggleMaximizeWindow"
                    AutomationProperties.Name="最大化或还原窗口">
                <PathIcon Width="13" Height="13"
                          Data="M 2,2 L 11,2 L 11,3 L 2,3 Z
                                M 2,10 L 11,10 L 11,11 L 2,11 Z
                                M 2,3 L 3,3 L 3,10 L 2,10 Z
                                M 10,3 L 11,3 L 11,10 L 10,10 Z" />
            </Button>
            <Button Classes="WindowControl Close" Click="CloseWindow"
                    AutomationProperties.Name="关闭窗口">
                <PathIcon Width="13" Height="13"
                          Data="M 2,3 L 3,2 L 11,10 L 10,11 Z
                                M 10,2 L 11,3 L 3,11 L 2,10 Z" />
            </Button>
        </StackPanel>

        <Border IsVisible="{Binding IsConfirmationOpen}" Background="#660F1722"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="Glass" Background="{DynamicResource GlassStrongBrush}"
                    Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding ConfirmationTitle}" FontSize="22" FontWeight="SemiBold"
                               LineHeight="28"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap"
                               Classes="Body" TextAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="确认" Command="{Binding ConfirmCommand}" Classes="Primary" />
                        <Button IsVisible="{Binding CanDiscardConfirmation}" Content="放弃并离开"
                                Command="{Binding DiscardAndLeaveCommand}" Classes="Glass" />
                        <Button Content="取消" Command="{Binding CancelConfirmationCommand}" Classes="Glass" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <views:LaunchMotionSurface x:Name="LaunchMotion"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   AutomationProperties.Name="Guardian 启动动画" />
    </Grid>
    </Border>
</Window>
